EdgeStyle;rounded=1;html=1;fontSize=11;endArrow=open;endFill=0;startArrow=none;strokeColor=#b8860b;strokeWidth=2;labelBackgroundColor=none;" edge="1" parent="1" source="n_conv" target="n_store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l107" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e106"><mxGeometry x="-0.82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l108" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e106"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e109" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=open;endFill=0;startArrow=none;strokeColor=#4d4d4d;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;" edge="1" parent="1" source="n_user" target="n_noti"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l110" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e109"><mxGeometry x="-0.82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l111" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e109"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="lg" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Hộp vàng&lt;/b&gt; = thực thể / quan hệ &lt;b&gt;mới hoặc đã sửa&lt;/b&gt; so với v2 (đường vàng đậm là quan hệ mới/sửa).&lt;br&gt;&lt;b&gt;• Hộp vàng nét đứt&lt;/b&gt; = &lt;b&gt;thực thể liên kết&lt;/b&gt;: quan hệ N:N &lt;i&gt;có thuộc tính riêng&lt;/i&gt; nên phải tách thành thực thể — &lt;i&gt;Store Staff Assignment&lt;/i&gt; (status, invited_at, responded_at), &lt;i&gt;Cart Item&lt;/i&gt; &amp; &lt;i&gt;Order Item&lt;/i&gt; (quantity, unit_price).&lt;br&gt;&lt;b&gt;• Owner vs Staff&lt;/b&gt;: &lt;i&gt;User owns Garden Store&lt;/i&gt; (chủ shop) tách riêng khỏi &lt;i&gt;Store Staff Assignment&lt;/i&gt; (nhân viên được mời theo từng cửa hàng) — hệ thống &lt;b&gt;không có role toàn cục &quot;Garden Staff&quot;&lt;/b&gt;.&lt;br&gt;&lt;b&gt;• Ngũ hành&lt;/b&gt;: &lt;i&gt;Product&lt;/i&gt; và &lt;i&gt;Workspace Profile&lt;/i&gt; cùng quy về thực thể &lt;i&gt;Element&lt;/i&gt; → đó là cơ sở để so khớp và chấm điểm gợi ý.&lt;br&gt;&lt;b&gt;• Cart / Order trỏ tới Product Item (Variant)&lt;/b&gt;, không trỏ thẳng Product — vì giá và tồn kho nằm ở variant." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="1620" height="150" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
