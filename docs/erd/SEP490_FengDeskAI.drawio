lineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="act_box"><mxGeometry x="40" y="340" width="40" height="70" as="geometry"/></mxCell><mxCell id="a_stf_n" value="Được Owner mời · xử lý đơn&lt;br&gt;và giao hàng của cửa hàng đó" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="act_box"><mxGeometry x="100" y="350" width="190" height="50" as="geometry"/></mxCell><mxCell id="a_plt" value="Platform Staff / Manager" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="act_box"><mxGeometry x="40" y="480" width="40" height="70" as="geometry"/></mxCell><mxCell id="a_plt_n" value="Vận hành sàn · hỗ trợ khách&lt;br&gt;duyệt trả hàng · hàng chờ Model 3D" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="act_box"><mxGeometry x="100" y="490" width="190" height="50" as="geometry"/></mxCell><mxCell id="a_adm" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="act_box"><mxGeometry x="40" y="620" width="40" height="70" as="geometry"/></mxCell><mxCell id="a_adm_n" value="Quản trị người dùng · phân quyền&lt;br&gt;(mọi thay đổi đều ghi audit log)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="act_box"><mxGeometry x="100" y="630" width="190" height="50" as="geometry"/></mxCell><mxCell id="sys" value="FengDeskAI&lt;br&gt;&lt;i&gt;Nền tảng thương mại điện tử cây &amp; vật phẩm phong thuỷ&lt;br&gt;cho bàn làm việc, có gợi ý bằng AI&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Sàn nhiều cửa hàng (multi-store)&lt;br&gt;• Hồ sơ workspace → chấm điểm ngũ hành&lt;br&gt;• Chatbot AI tư vấn&lt;br&gt;• Xem sản phẩm dạng mô hình 3D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f6fb2;strokeColor=#0d4a7a;fontColor=#ffffff;fontSize=16;fontStyle=1;verticalAlign=middle;arcSize=6;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="420" height="280" as="geometry"/></mxCell><mxCell id="ext_box" value="Hệ thống bên thứ 3" style="swimlane;html=1;startSize=30;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="100" width="480" height="760" as="geometry"/></mxCell><mxCell id="x_supa" value="Supabase&lt;br&gt;&lt;i&gt;PostgreSQL + Object Storage&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="50" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_payos" value="PayOS&lt;br&gt;&lt;i&gt;cổng thanh toán&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="140" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_ghn" value="GHN&lt;br&gt;&lt;i&gt;đơn vị vận chuyển&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="230" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_smtp" value="Gmail SMTP&lt;br&gt;&lt;i&gt;gửi email OTP&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="320" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_goog" value="Google Identity&lt;br&gt;&lt;i&gt;OAuth 2.0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="410" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_vmap" value="VietMap&lt;br&gt;&lt;i&gt;bản đồ · geocoding&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="500" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_meshy" value="Meshy&lt;br&gt;&lt;i&gt;sinh mô hình 3D từ ảnh&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="590" width="360" height="70" as="geometry"/></mxCell><mxCell id="x_ai" value="AI Relay (Ollama)&lt;br&gt;&lt;i&gt;LLM tự vận hành, ngoài VPS&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#5a5a5a;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=12;" vertex="1" parent="ext_box"><mxGeometry x="60" y="680" width="360" height="70" as="geometry"/></mxCell><mxCell id="e_a_cus" value="mua sắm · nhận gợi ý&lt;br&gt;&lt;i&gt;HTTPS&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;strokeWidth=1.5;strokeColor=#0d4a7a;labelBackgroundColor=none;" edge="1" parent="1" source="a_cus" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a_own" value="quản lý cửa hàng&lt;br&gt;&lt;i&gt;HTTPS&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;strokeWidth=1.5;strokeColor=#0d4a7a;labelBackgroundColor=none;" edge="1" parent="1" source="a_own" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a_stf" value="xử lý đơn của cửa hàng&lt;br&gt;&lt;i&gt;HTTPS&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;strokeWidth=1.5;strokeColor=#0d4a7a;labelBackgroundColor=none;" edge="1" parent="1" source="a_stf" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a_plt" value="vận hành sàn&lt;br&gt;&lt;i&gt;HTTPS&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;strokeWidth=1.5;strokeColor=#0d4a7a;labelBackgroundColor=none;" edge="1" parent="1" source="a_plt" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a_adm" value="quản trị hệ thống&lt;br&gt;&lt;i&gt;HTTPS&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;strokeWidth=1.5;strokeColor=#0d4a7a;labelBackgroundColor=none;" edge="1" parent="1" source="a_adm" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_supa" value="→ SQL (TCP 5432) · upload ảnh (HTTPS)&lt;br&gt;← dữ liệu · public URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_supa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_payos" value="→ tạo payment link (HTTPS)&lt;br&gt;← checkoutUrl · &lt;b&gt;webhook kết quả&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_payos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_ghn" value="→ tính phí · tạo vận đơn (HTTPS)&lt;br&gt;← phí · mã vận đơn · &lt;b&gt;webhook trạng thái&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_ghn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_smtp" value="→ gửi OTP (SMTP 587 · STARTTLS)&lt;br&gt;← 250 OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_smtp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_goog" value="→ OAuth · verify idToken (HTTPS)&lt;br&gt;← thông tin tài khoản" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_goog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_vmap" value="→ geocode · tile bản đồ (HTTPS)&lt;br&gt;← toạ độ · bản đồ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_vmap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_meshy" value="→ ảnh sản phẩm (HTTPS)&lt;br&gt;← mô hình 3D (.glb)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_meshy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_x_ai" value="→ prompt + tool-calling (HTTPS)&lt;br&gt;← câu trả lời tư vấn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=classic;startArrow=classic;strokeWidth=1.5;strokeColor=#5a5a5a;labelBackgroundColor=none;verticalAlign=middle;" edge="1" parent="1" source="sys" target="x_ai"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Mức C4-L1: toàn bộ FengDeskAI được xem là &lt;b&gt;một hộp đen&lt;/b&gt; — chi tiết bên trong xem page &lt;i&gt;System Architecture&lt;/i&gt;.&lt;br&gt;• &lt;b&gt;Không tồn tại role toàn hệ thống &quot;Garden Staff&quot;&lt;/b&gt; — đây là quyền theo từng cửa hàng (bảng &lt;i&gt;garden_staff_assignments&lt;/i&gt;, trạng thái Accepted).&lt;br&gt;• Một tài khoản có thể mang &lt;b&gt;nhiều vai trò cùng lúc&lt;/b&gt; (UserRole dạng [Flags]) — ví dụ vừa Customer vừa Garden Owner.&lt;br&gt;• &lt;b&gt;PayOS&lt;/b&gt; và &lt;b&gt;GHN&lt;/b&gt; là hai hệ thống &lt;b&gt;gọi ngược&lt;/b&gt; vào FengDeskAI qua webhook, không chỉ nhận lệnh một chiều.&lt;br&gt;• Đã lược &lt;i&gt;Ahamove&lt;/i&gt; và &lt;i&gt;Speech-to-Text (Moonshine/Whisper)&lt;/i&gt; để giữ sơ đồ gọn — bổ sung nếu cần đầy đủ." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="1600" height="130" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>

  <diagram id="CONCEPTUALV3PAGE01" name="Conceptual diagram v3">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="FengDeskAI – Conceptual Diagram (v3)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1620" height="40" as="geometry"/></mxCell><mxCell id="n_wstype" value="Workspace Type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="n_wsprof" value="Workspace Profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="n_rec" value="Recommendation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="n_rule" value="Feng Shui Rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="n_cat" value="Category" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="n_addr" value="Address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="n_user" value="User" style="rounded=0;whiteSpac