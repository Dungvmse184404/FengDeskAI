<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Bo du lieu test (TestData/datasets/*.json) doc luc chay -> phai co trong thu muc output. -->
  <ItemGroup>
    <Content Include="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Connection string cuc bo cua tung may. Dung wildcard (khong phai duong dan co dinh) de build
    van chay khi lap trinh vien chua tao file - luc do TestDatabaseGuard se bao loi kem huong dan.
    File nay da nam trong .gitignore theo mau **/appsettings.*.json.
  -->
  <ItemGroup>
    <Content Include="appsettings.Testing*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Seeder đọc JSON từ {BaseDirectory}/seed-data (đường dẫn SeedDataLoader hỗ trợ sẵn cho Docker).
    Copy sang thư mục output để test chạy được ở bất kỳ working directory nào, gồm cả CI.
  -->
  <ItemGroup>
    <Content Include="..\..\seed-data\**\*.json"
             Link="seed-data\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FengDeskAI.Domain\FengDeskAI.Domain.csproj" />
    <ProjectReference Include="..\..\src\FengDeskAI.Application\FengDeskAI.Application.csproj" />
    <ProjectReference Include="..\..\src\FengDeskAI.Infrastructure\FengDeskAI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\FengDeskAI.WebAPI\FengDeskAI.WebAPI.csproj" />
  </ItemGroup>

</Project>
